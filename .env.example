# Copy this file to .env and fill in your key. .env is never committed.
CHEFSCOUT_ANTHROPIC_API_KEY=

# Model and effort. Haiku is the cheapest; switch to claude-opus-5-5 for best quality.
CHEFSCOUT_MODEL=claude-haiku-5-5
CHEFSCOUT_EFFORT=low

# Where profiles, conversations and caches are stored.
CHEFSCOUT_DATA_DIR=data

# Cost guard: maximum web searches per user request.
CHEFSCOUT_MAX_WEB_SEARCHES=3

# Server (127.0.0.1 = only this computer can open it).
CHEFSCOUT_HOST=127.0.0.1
CHEFSCOUT_PORT=8000
CHEFSCOUT_LOG_LEVEL=INFO
